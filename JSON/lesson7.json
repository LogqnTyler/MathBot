                    {
                        "part": "a",
                        "plain_text": {
                            "question": "d/dt[f(t)/g(t)] evaluated at t = 1, where f(1) = 2, f'(1) = 3, g(1) = -3, and g'(1) = -1",
                            "answer": "d/dt[f(t)/g(t)]|_{t=1} = (f'(t)g(t) - f(t)g'(t))/(g(t))^2 |_{t=1} = (f'(1)g(1) - f(1)g'(1))/(g(1))^2 = -7/9"
                        },
                        "latex": {
                            "question": "$\\frac{d}{dt}\\left[\\frac{f(t)}{g(t)}\\right]\\bigg|_{t=1}$, where $f(1)=2$, $f'(1)=3$, $g(1)=-3$, and $g'(1)=-1$",
                            "answer": "$\\frac{d}{dt}\\left[\\frac{f(t)}{g(t)}\\right]\\bigg|_{t=1}=\\frac{f'(t)g(t)-f(t)g'(t)}{(g(t))^2}\\bigg|_{t=1}=\\frac{f'(1)g(1)-f(1)g'(1)}{(g(1))^2}=-\\frac{7}{9}$"
                        }
                    },
                    {
                        "part": "b",
                        "plain_text": {"question": "d/dz[z^3/(1+z^2)]", "answer": "(3z^2(1+z^2) - z^3(2z))/(1+z^2)^2"},
                        "latex": {"question": "$\\frac{d}{dz}\\left[\\frac{z^3}{1+z^2}\\right]$", "answer": "$\\frac{d}{dz}\\left[\\frac{z^3}{1+z^2}\\right]=\\frac{3z^2(1+z^2)-z^3(2z)}{(1+z^2)^2}$"}
                    },
                    {
                        "part": "c",
                        "plain_text": {
                            "question": "d/dz[z^3 g(z)/(1+z^2)] evaluated at z = 1, where g(1) = 0 and g'(1) = -2",
                            "answer": "d/dz[z^3 g(z)/(1+z^2)]|_{z=1} = ((3z^2 g(z) + z^3 g'(z))(1+z^2) - z^3 g(z)(2z))/(1+z^2)^2 |_{z=1} = ((3(1)^2 g(1) + (1)^3 g'(1))(1+(1)^2) - (1)^3 g(1)(2))/(1+(1)^2)^2 = (-4 - 0)/4 = -1"
                        },
                        "latex": {
                            "question": "$\\frac{d}{dz}\\left[\\frac{z^3g(z)}{1+z^2}\\right]\\bigg|_{z=1}$, where $g(1)=0$ and $g'(1)=-2$",
                            "answer": "$\\frac{d}{dz}\\left[\\frac{z^3g(z)}{1+z^2}\\right]\\bigg|_{z=1}=\\frac{(3z^2g(z)+z^3g'(z))(1+z^2)-z^3g(z)(2z)}{(1+z^2)^2}\\bigg|_{z=1}=\\frac{(3(1)^2g(1)+(1)^3g'(1))(1+(1)^2)-(1)^3g(1)(2)}{(1+(1)^2)^2}=\\frac{-4-0}{4}=-1$"
                        }
                    },
                    {
                        "part": "d",
                        "plain_text": {
                            "question": "d/dt[(cube root of t + 1)/(e^t(t^2-2t+2))]",
                            "answer": "d/dt[(cube root of t + 1)/(e^t(t^2-2t+2))] = ((1/3)t^(-2/3) e^t(t^2-2t+2) - (cube root of t + 1)(e^t(t^2-2t+2) + e^t(2t-2)) / (e^(2t)(t^2-2t+2)^2)"
                        },
                        "latex": {
                            "question": "$\\frac{d}{dt}\\left[\\frac{\\sqrt[3]{t}+1}{e^t(t^2-2t+2)}\\right]$",
                            "answer": "$\\frac{d}{dt}\\left[\\frac{\\sqrt[3]{t}+1}{e^t(t^2-2t+2)}\\right]=\\frac{(1/3)t^{-2/3}e^t(t^2-2t+2)-(\\sqrt[3]{t}+1)(e^t(t^2-2t+2)+e^t(2t-2))}{e^{2t}(t^2-2t+2)^2}$"
                        }
                    }
                ]
            },
            {
