                "subproblems": [
                    {
                        "part": "a",
                        "plain_text": {"question": "Complete the Quotient Rule: d/dx[hi(x)/lo(x)] =", "answer": "(lo(x) * hi'(x) - hi(x) * lo'(x)) / (lo(x))^2"},
                        "latex": {"question": "Complete the Quotient Rule: $\\frac{d}{dx}\\left[\\frac{hi(x)}{lo(x)}\\right]=$", "answer": "$\\frac{lo(x)hi'(x)-hi(x)lo'(x)}{(lo(x))^2}$"}
                    }
                ]
            },
            {
                "name": "Example: Quotient rule derivative",
                "learning_tag": 2,
                "context_plain": "",
                "context_latex": "",
                "keywords": ["quotient rule", "derivative"],
                "subproblems": [
                    {
                        "part": "a",
                        "plain_text": {
                            "question": "Find d/dy[(y^3-y^2+1)/(1-y)] evaluated at y = 0.",
                            "answer": "d/dy[(y^3-y^2+1)/(1-y)] = ((1-y)(3y^2-2y) - (y^3-y^2+1)(-1)) / (1-y)^2. Plug in y = 0: ((1-0)(3(0)^2-2(0)) - ((0)^3-(0)^2+1)(-1)) / (1-0)^2 = 1."
                        },
                        "latex": {
                            "question": "$\\frac{d}{dy}\\left[\\frac{y^3-y^2+1}{1-y}\\right]\\bigg|_{y=0}$",
                            "answer": "$\\frac{d}{dy}\\left[\\frac{y^3-y^2+1}{1-y}\\right]=\\frac{(1-y)(3y^2-2y)-(y^3-y^2+1)(-1)}{(1-y)^2}$. Plug in $y=0$: $\\frac{(1-0)(3(0)^2-2(0))-((0)^3-(0)^2+1)(-1)}{(1-0)^2}=1$."
                        }
                    }
                ]
            },
            {
                "name": "Exercise: Quotient rule",
                "learning_tag": 2,
