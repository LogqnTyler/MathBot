   "source": [
    "\n",
    "model = SentenceTransformer(\"BAAI/bge-m3\", model_kwargs={\"torch_dtype\": \"float16\"})\n",
    "\n",
    "sentences = [\n",
    "    \"I like to eat pie\", \n",
    "    \"Pie is a good food\",\n",
    "    \"Birds are not real\"\n",
    "]\n",
    "embeddings = model.encode(sentences)\n",
    "\n",
    "similarities = model.similarity(embeddings, embeddings)\n",
    "print(similarities.shape)"
   ]
