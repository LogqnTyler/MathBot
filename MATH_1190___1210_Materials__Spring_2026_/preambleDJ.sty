%%%%%%%%%%% LEARNING TARGETS %%%%%%%%%%%%%% code below this line is added by Caelan
%

\newcommand{\target}[1]{%
    % Assign the first letter of #1 to the string \TargetGroup
    \StrLeft{#1}{1}[\TargetGroup]% 
    \IfEqCase{\TargetGroup}{%
        {F}{{\bf\color{CornflowerBlue}#1}}%
        {L}{{\bf\color{RoyalBlue}#1}}%
        {D}{{\bf\color{ForestGreen}#1}}%
        {A}{{\bf\color{Red}#1}}%
        {I}{{\bf\color{Plum}#1}}%
        {P}{{\bf\color{Orange}#1}}%
    }[\PackageError{tree}{Undefined option to target: #1}{}]%
}